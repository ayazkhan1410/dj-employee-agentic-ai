# -------------------------
# Security / Core
# -------------------------
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Karachi

# -------------------------
# CORS
# -------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# -------------------------
# Database (Docker MySQL = source of truth)
# -------------------------
# Compose backend uses DB_HOST=db automatically.
# Local manage.py/shell: DB_HOST=127.0.0.1 and DB_PORT=3307 (Compose publishes 3307→3306).
DB_ENGINE=django.db.backends.mysql
DB_NAME=ai_employee_db
DB_USER=ai_employee
DB_PASSWORD=ai_employee_pass
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_ROOT_PASSWORD=rootpass

# -------------------------
# JWT / API
# -------------------------
JWT_ACCESS_DAYS=1
JWT_REFRESH_DAYS=7
PAGE_SIZE=5

# -------------------------
# Gemini / AI
# -------------------------
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEST_PROMPT=Explain Quantum Computing in one sentence.

# -------------------------
# Frontend (Docker Compose)
# -------------------------
VITE_API_URL=http://localhost:8000
